# Production uses the official MCP Python SDK over stdio.
ATLAS_MCP_TRANSPORT=stdio
ATLAS_INDEX_PATH=/tmp/atlas-rag/rag_index.sqlite3
ATLAS_ACTION_LOG=/tmp/atlas-mock-actions.jsonl

# OpenAI-compatible refinement layer. Keep the real key only in Render or your local shell.
# ATLAS_LLM_BASE_URL=https://openrouter.ai/api/v1
# ATLAS_LLM_API_KEY=
# ATLAS_LLM_MODEL=openai/gpt-oss-20b:free
# ATLAS_LLM_TIMEOUT_SECONDS=90
# ATLAS_LLM_MAX_RETRIES=2
# ATLAS_PUBLIC_URL=https://atlas-hr-agent.onrender.com

# Learned semantic embeddings reuse the OpenRouter base URL and API key above by default.
# ATLAS_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# ATLAS_EMBEDDING_BATCH_SIZE=32
# ATLAS_EMBEDDING_TIMEOUT_SECONDS=120
# ATLAS_EMBEDDING_MAX_RETRIES=3
# Optional separate credentials:
# ATLAS_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# ATLAS_EMBEDDING_API_KEY=
