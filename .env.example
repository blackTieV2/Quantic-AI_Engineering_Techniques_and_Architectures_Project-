# Production uses the official MCP Python SDK over stdio.
ATLAS_MCP_TRANSPORT=stdio
ATLAS_INDEX_PATH=/tmp/atlas-rag/rag_index.sqlite3
ATLAS_ACTION_LOG=/tmp/atlas-mock-actions.jsonl

# Optional OpenAI-compatible refinement layer. Leave unset for deterministic mode.
# ATLAS_LLM_BASE_URL=https://api.openai.com/v1
# ATLAS_LLM_API_KEY=
# ATLAS_LLM_MODEL=gpt-4.1-mini
